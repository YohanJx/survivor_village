[gd_resource type="Resource" script_class="CardDefinition" load_steps=25 format=3]

[ext_resource type="Script" path="res://scripts/resources/card_definition.gd" id="s_card_definition"]
[ext_resource type="Script" path="res://scripts/resources/resource_cost.gd" id="s_resource_cost"]
[ext_resource type="Script" path="res://scripts/resources/building_requirement.gd" id="s_building_requirement"]
[ext_resource type="Resource" path="res://data/buildings/well.tres" id="b_well"]
[ext_resource type="Script" path="res://scripts/resources/card_effect.gd" id="s_card_effect"]
[ext_resource type="Resource" path="res://data/buildings/filter.tres" id="b_filter"]

[ext_resource type="Script" path="res://scripts/resources/keyword_definition.gd" id="keyword"]
[ext_resource type="Resource" path="res://data/keywords/water_source.tres" id="kw_water_source"]
[ext_resource type="Resource" path="res://data/keywords/technology.tres" id="kw_technology"]
[ext_resource type="Resource" path="res://data/keywords/engineer.tres" id="kw_engineer"]

[ext_resource type="Texture2D" path="res://assets/cards/individual/filter.png" id="illustration"]

[ext_resource type="Resource" path="res://data/buildings/well.tres" id="source_well"]

[ext_resource type="Resource" path="res://data/buildings/river_windmill.tres" id="source_river_windmill"]

[ext_resource type="Resource" path="res://data/buildings/rain_collector.tres" id="source_rain_collector"]

[ext_resource type="Resource" path="res://data/buildings/solar_still.tres" id="source_solar_still"]

[sub_resource type="Resource" id="cost_0"]
script = ExtResource("s_resource_cost")
key = 0
amount = 12

[sub_resource type="Resource" id="cost_1"]
script = ExtResource("s_resource_cost")
key = 4
amount = 8

[sub_resource type="Resource" id="requirement_0"]
script = ExtResource("s_building_requirement")
level = 1
building = ExtResource("b_well")

[sub_resource type="Resource" id="effect_0"]
script = ExtResource("s_card_effect")
type = 1
amount = 1.0
building = ExtResource("b_filter")

[sub_resource type="Resource" id="effect_1"]
script = ExtResource("s_card_effect")
type = 0
key = 2
amount = -2.0

[sub_resource type="Resource" id="source_well"]
script = ExtResource("s_building_requirement")
building = ExtResource("source_well")
level = 1

[sub_resource type="Resource" id="source_river_windmill"]
script = ExtResource("s_building_requirement")
building = ExtResource("source_river_windmill")
level = 1

[sub_resource type="Resource" id="source_rain_collector"]
script = ExtResource("s_building_requirement")
building = ExtResource("source_rain_collector")
level = 1

[sub_resource type="Resource" id="source_solar_still"]
script = ExtResource("s_building_requirement")
building = ExtResource("source_solar_still")
level = 1

[resource]
script = ExtResource("s_card_definition")
illustration = ExtResource("illustration")
profession = 3
id = "filter"
display_name = "净水器图纸"
kind = 1
icon = 1
color = 1
description = "用炭和砂石净化水源，让工业与水井能够共存。"
positive = "水井免受污染减产；取水额外 +5"
negative = "每天材料 -1；建造耗水 2"
reusable = false
costs = Array[ExtResource("s_resource_cost")]([SubResource("cost_0"), SubResource("cost_1")])
effects = Array[ExtResource("s_card_effect")]([SubResource("effect_0"), SubResource("effect_1")])
building = ExtResource("b_filter")
labor = 4

keywords = Array[ExtResource("keyword")]([ExtResource("kw_water_source"), ExtResource("kw_technology"), ExtResource("kw_engineer")])

any_prerequisites = Array[ExtResource("s_building_requirement")]([SubResource("source_well"), SubResource("source_river_windmill"), SubResource("source_rain_collector"), SubResource("source_solar_still")])
