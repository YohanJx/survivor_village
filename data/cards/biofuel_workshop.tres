kind = 2
icon = 13
color = 2
illustration = ExtResource("illustration")
description = "每天燃料 +2。每天食物 −2、水 −1；运转噪声 +1、污染 +1；缺少岗位或原料时整批停产。"
positive = "每天燃料 +2"
negative = "每天食物 −2、水 −1；运转噪声 +1、污染 +1；缺少岗位或原料时整批停产"
reusable = false
guaranteed_unlock = true
