[resource]
script = ExtResource("s_card_definition")
illustration = ExtResource("illustration")
profession = 2
id = "greenhouse"
display_name = "灌溉系统图纸"
kind = 2
icon = 0
color = 0
description = "把河岸引水、水井或集雨集水与菜圃连接起来，形成可持续的补给循环。"
positive = "供电时：菜圃产量 +50%，不再额外耗水"
negative = "每夜耗电 3；污染 +3"
reusable = false
costs = Array[ExtResource("s_resource_cost")]([SubResource("cost_0"), SubResource("cost_1"), SubResource("cost_2")])
prerequisites = Array[ExtResource("s_building_requirement")]([SubResource("requirement_0")])
effects = Array[ExtResource("s_card_effect")]([SubResource("effect_0"), SubResource("effect_1")])
building = ExtResource("b_greenhouse")
labor = 5

keywords = Array[ExtResource("keyword")]([ExtResource("kw_synergy"), ExtResource("kw_production"), ExtResource("kw_builder")])

any_prerequisites = Array[ExtResource("s_building_requirement")]([SubResource("source_well"), SubResource("source_river_windmill"), SubResource("source_rain_collector"), SubResource("source_solar_still")])
