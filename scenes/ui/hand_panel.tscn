[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/hand_panel.gd" id="ui_script"]

[node name="HandPanel" type="VBoxContainer"]
unique_name_in_owner = true
script = ExtResource("ui_script")
theme_override_constants/separation = 10

[node name="Heading" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="HandTitle" type="Label" parent="Heading"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 17
theme_override_colors/font_color = Color(0.86, 0.83, 0.75, 1)
text = "今日的选择"

[node name="Hint" type="Label" parent="Heading"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.64, 0.60, 0.52, 1)
text = "选择行动"
clip_text = true

[node name="KeywordFilter" type="OptionButton" parent="Heading"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 13

[node name="SkipButton" type="Button" parent="Heading"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
text = "待命  ·  体力 +8"

[node name="HandScroll" type="ScrollContainer" parent="."]
custom_minimum_size = Vector2(0, 322)
layout_mode = 2
vertical_scroll_mode = 0

[node name="HandContainer" type="HBoxContainer" parent="HandScroll"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12
