[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/hand_panel.gd" id="ui_script"]

[node name="HandPanel" type="VBoxContainer"]
unique_name_in_owner = true
script = ExtResource("ui_script")
theme_override_constants/separation = 10

[node name="HandScroll" type="ScrollContainer" parent="."]
custom_minimum_size = Vector2(0, 0)
layout_mode = 2
size_flags_vertical = 3
vertical_scroll_mode = 1

[node name="HandContainer" type="HBoxContainer" parent="HandScroll"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 16

[node name="EmptyCategory" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "暂无符合条件的卡牌 · 探索与发展后可获得更多卡牌"
horizontal_alignment = 1
autowrap_mode = 3
